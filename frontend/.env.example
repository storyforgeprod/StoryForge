# Frontend — Variables de Entorno

# ============================================
# SUPABASE — Auth + Storage + Database
# ============================================
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxxxx_paste_your_key_here

# ============================================
# API Backend
# ============================================
# Development
VITE_API_URL=http://localhost:3000

# Staging (una vez deployado)
# VITE_API_URL=https://storyforge-backend-staging.onrender.com

# Production
# VITE_API_URL=https://storyforge-backend.onrender.com

# ============================================
# OBSERVABILITY — Error tracking + Analytics
# ============================================
VITE_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
VITE_SENTRY_ENVIRONMENT=development

VITE_POSTHOG_KEY=xxxxx_paste_your_key_here
VITE_POSTHOG_URL=https://app.posthog.com

# ============================================
# FEATURE FLAGS (para MVP)
# ============================================
VITE_ENABLE_TEXT_TO_SPEECH=true
VITE_ENABLE_VIDEO_RENDER=true
VITE_ENABLE_PREVIEW_EDIT=false  # Solo para fase 2+

# ============================================
# DEVELOPMENT
# ============================================
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=info  # debug | info | warn | error

# OAuth redirect (configure in Supabase Dashboard → Auth → URL Configuration)
# Site URL: http://localhost:5173
# Redirect URLs: http://localhost:5173/auth/callback
