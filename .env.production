# StoryForge — Production Environment Template
# Copy to your hosting provider (Render, etc.). Do NOT commit real secrets.
# Version: 1.0 MVP · 2026-05-19

# ============ RUNTIME ============
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ============ DATABASE ============
# Supabase PostgreSQL connection string (pooler recommended for serverless)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ============ AUTHENTICATION ============
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_MIN_32_CHARS
JWT_EXPIRATION=24h

SUPABASE_PROJECT_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_SERVICE_ROLE

# ============ EXTERNAL AI APIs ============
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE
REPLICATE_API_TOKEN=r8_REPLACE
ELEVENLABS_API_KEY=sk_REPLACE

# ============ QUEUE (REDIS) ============
REDIS_HOST=your-redis.upstash.io
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=REPLACE

# ============ RATE LIMITING ============
RATE_LIMIT_SCRIPT=5
RATE_LIMIT_IMAGES=10
RATE_LIMIT_AUDIO=15
RATE_LIMIT_VIDEO=10
RATE_LIMIT_TTL_MS=60000

# ============ VIDEO / FFMPEG ============
VIDEO_OUTPUT_DIR=/tmp/storyforge-videos
FFMPEG_TIMEOUT_MS=300000

# ============ MONITORING ============
SENTRY_DSN=https://REPLACE@o000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# ============ CORS ============
CORS_ORIGIN=https://your-frontend-domain.com

# ============ FRONTEND (Vercel/Render static) ============
VITE_API_URL=https://your-api-domain.com
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE
