# Backend — Variables de Entorno

# ============================================
# NODE & ENVIRONMENT
# ============================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ============================================
# SUPABASE — Database + Auth + Storage
# ============================================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=xxxxx
SUPABASE_SERVICE_ROLE_KEY=xxxxx_keep_secret

DATABASE_URL=postgresql://postgres:password@db.supabase.co:5432/postgres

# ============================================
# REDIS — Queue + Cache (Upstash)
# ============================================
REDIS_URL=redis://default:xxxxx@xxx.upstash.io:xxxxx

# ============================================
# IA SERVICES — API Keys
# ============================================

# Azure OpenAI (Script Generation)
AZURE_OPENAI_ENDPOINT=https://<region>.openai.azure.com/
AZURE_OPENAI_API_KEY=xxxxx
AZURE_OPENAI_DEPLOYMENT_GPT41=gpt-4-1-deployment-name
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Foundry Image Generation (Flux.2-pro)
AZURE_FOUNDRY_IMAGE_ENDPOINT=https://<region>.openai.azure.com/
AZURE_FOUNDRY_IMAGE_API_KEY=xxxxx
AZURE_FOUNDRY_FLUX_DEPLOYMENT=flux-2-pro-deployment-name

# ElevenLabs (Text-to-Speech)
ELEVENLABS_API_KEY=xxxxx

# Modal (Serverless Video Render - opcional)
# MODAL_API_TOKEN_ID=ak-xxxxx
# MODAL_API_TOKEN_SECRET=xxxxx

# ============================================
# VIDEO ASSEMBLY STRATEGY
# ============================================
VIDEO_ASSEMBLY_STRATEGY=local   # 'local' (Task 4.5 FFmpeg on Render) | 'serverless' (Task 4.6 Modal)
# MODAL_FUNCTION_URL=https://your-modal-endpoint  # required only if strategy=serverless

# ============================================
# OBSERVABILITY
# ============================================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ============================================
# STRIPE (Billing - Phase 2+)
# ============================================
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# ============================================
# JWT / Authentication
# ============================================
# Supabase Dashboard → Settings → API → JWT Secret (HS256)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=7d

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173
# CORS_ORIGIN=https://storyforge.vercel.app  # Production

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_TEXT_TO_SPEECH=true
FEATURE_VIDEO_RENDER=true
FEATURE_PREVIEW_EDIT=false

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10
