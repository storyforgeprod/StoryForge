# Environment Configuration for StoryForge

# ============ BACKEND =============

# NestJS Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ============ DATABASE =============

# Supabase PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/storyforge

# ============ AUTHENTICATION =============

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=24h

# Supabase
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ============ EXTERNAL APIS =============

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Replicate
REPLICATE_API_TOKEN=r8_...

# ElevenLabs
ELEVENLABS_API_KEY=sk_...

# ============ QUEUE =============

# Redis (Bull Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ============ RATE LIMITING =============

# Rate Limiting (per minute, per endpoint)
RATE_LIMIT_SCRIPT=5
RATE_LIMIT_IMAGES=10
RATE_LIMIT_AUDIO=15
RATE_LIMIT_VIDEO=10
RATE_LIMIT_TTL_MS=60000

# ============ VIDEO PROCESSING =============

# FFmpeg Configuration
VIDEO_OUTPUT_DIR=/tmp/storyforge-videos
FFMPEG_TIMEOUT_MS=300000

# ============ MONITORING =============

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# ============ CORS =============

# CORS Origins
CORS_ORIGIN=http://localhost:5173

# ============ FRONTEND =============

# API URL for Frontend
VITE_API_URL=http://localhost:3000
